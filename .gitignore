# 工作区与工具缓存
.worktrees/
__pycache__/

# 代码生成的中间产物（step/ 是交付件，跟踪）
models/*.FCStd
models/*.FCBak
exports/*
reports/*.json

# renders/ 同时存放生成图与大体积参考网格
#   *.png 由 scripts/render_model.py、build_board_covers.py 生成
#   *.stl / *.FCStd 是从原始整机 CAD 导出的算料参考，不可由本仓库代码再生
renders/*.png
!renders/handheld_stack_exploded_preview.png
renders/*.stl
renders/*.FCStd

# 已选用的 V6 参数、验证数据与预览纳入版本管理
!reports/rtk_mount_v6_parameters.json
!reports/rtk_mount_review_v6_20261028.json
!reports/rtk_scan_occlusion_v6_20261028.json
!reports/rtk_shadow_3d_v6_20261028.json
!reports/rtk_shadow_viewer_qa_v6_20261028.json
!reports/rtk_mount_v6_browser_qa.json
!reports/rtk_mount_v6_selection.json
!renders/rtk_scan_occlusion_3d_v6_20261028.png

